<?xml version="1.0" encoding="utf-8"?>
<com.android.systemui.statusbar.notification.row.SmartNotificationDecorView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/smart_notification_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="visible">

    <LinearLayout
        android:id="@+id/smart_notification_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_summarize_notifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="visible"
            android:text="Summarize Notifications" />

        <TextView
            android:id="@+id/tv_notification_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:textAlignment="center"
            android:visibility="gone" />

    </LinearLayout>
</com.android.systemui.statusbar.notification.row.SmartNotificationDecorView>