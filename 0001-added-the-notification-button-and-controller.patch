+    /**
+     * Updates visibility of the smart notification summarization header.
+     * Shows when there are active notifications to summarize; hides when empty.
+     */
+    public void updateSmartNotificationVisibility() {
+        if (mSmartNotificationHeader == null) {
+            return;
+        }
+
+        // Check if there are active notifications in the stack
+        boolean hasActiveNotifications = getVisibleNotificationCount() > 0;
+
+        // If the summary text is currently shown, reset it when all notifications are cleared
+        if (!hasActiveNotifications && mTvSummary != null) {
+            mTvSummary.setVisibility(View.GONE);
+        }
+
+        // Animate the decor view in or out
+        mSmartNotificationHeader.setVisible(hasActiveNotifications, /* animate = */ true);
+    }
+
+    /**
+     * Extracts active notifications, filters background noise, and formats
+     * structured prompt data for the LLM inference service.
+     */
+    private void performNotificationSummary() {
+        Log.i(SMART_TAG, "--- Generating LLM Prompt Payload ---");
+
+        if (mNotifPipeline == null || mBtnSummarize == null || mTvSummary == null) {
+            Log.e(SMART_TAG, "Dependencies not ready for payload generation");
+            return;
         }
+
+        Collection<NotificationEntry> allNotifs = mNotifPipeline.getAllNotifs();
+        List<String> promptPayloads = new ArrayList<>();
+        SimpleDateFormat timeFormat = new SimpleDateFormat("HH:mm", Locale.US);
+
+        for (NotificationEntry entry : allNotifs) {
+            if (entry == null || entry.getSbn() == null) {
+                continue;
+            }
+
+            StatusBarNotification sbn = entry.getSbn();
+
+            // 1. FILTER: Ignore persistent / ongoing notifications (Media players, USB debugging, VPNs)
+            if (sbn.isOngoing() || !entry.isClearable()) {
+                Log.d(SMART_TAG, "Filtered out ongoing/system sticky notification: " + sbn.getPackageName());
+                continue;
+            }
+
+            Notification notif = sbn.getNotification();
+            Bundle extras = notif.extras;
+            if (extras == null) {
+                continue;
+            }
+
+            // 2. EXTRACT: Metadata
+            String pkg = sbn.getPackageName();
+            String category = notif.category != null ? notif.category : "general";
+            String postTime = timeFormat.format(new Date(sbn.getPostTime()));
+
+            // 3. EXTRACT: Text Content
+            CharSequence title = extras.getCharSequence(Notification.EXTRA_TITLE);
+            CharSequence text = extras.getCharSequence(Notification.EXTRA_BIG_TEXT);
+            if (text == null || text.length() == 0) {
+                text = extras.getCharSequence(Notification.EXTRA_TEXT);
+            }
+            CharSequence subText = extras.getCharSequence(Notification.EXTRA_SUB_TEXT);
+
+            // Skip empty notifications
+            if ((title == null || title.length() == 0) && (text == null || text.length() == 0)) {
+                continue;
+            }
+
+            // 4. STRUCTURE: Deterministic prompt record for LLM context
+            StringBuilder record = new StringBuilder();
+            record.append("[APP: ").append(pkg);
+            record.append(" | CAT: ").append(category);
+            record.append(" | TIME: ").append(postTime);
+            if (subText != null && subText.length() > 0) {
+                record.append(" | SUB: ").append(subText);
+            }
+            record.append(" | SENDER: ").append(title != null ? title : "Unknown");
+            record.append("] PAYLOAD: ").append(text != null ? text : "");
+
+            String payloadString = record.toString().trim();
+            promptPayloads.add(payloadString);
+            Log.d(SMART_TAG, "Ingested: " + payloadString);
+        }
+
+        Log.i(SMART_TAG, "Prompt batch prepared: " + promptPayloads.size() + " items");
+
+        if (promptPayloads.isEmpty()) {
+            Log.w(SMART_TAG, "Zero actionable notifications after filtering. Aborting.");
+            return;
+        }
+
+        // 5. Convert to Array for AIDL (matches: in String[] notificationPayloads)
+        String[] payloadArray = promptPayloads.toArray(new String[0]);
+
+        // 6. UI State: Indicate dispatching
+        mBtnSummarize.setEnabled(false);
+        mBtnSummarize.setText("Inferring (" + payloadArray.length + " items)...");
+
+        // TODO: Replace this simulated latency with:
+        // mSmartNotificationManager.summarizeNotifications(payloadArray, result -> { ... });
+        mBtnSummarize.postDelayed(() -> {
+            // Displaying the structured data directly on screen for developer verification
+            StringBuilder debugView = new StringBuilder();
+            debugView.append("=== INGESTED PROMPT DATA (").append(payloadArray.length).append(" items) ===\n\n");
+            for (String item : payloadArray) {
+                debugView.append(item).append("\n\n");
+            }
+
+            mTvSummary.setText(debugView.toString().trim());
+            mTvSummary.setVisibility(View.VISIBLE);
+
+            if (mSmartNotificationHeader != null) {
+                mSmartNotificationHeader.notifyHeightChanged(/* needsAnimation = */ true);
+            }
+
+            mBtnSummarize.setEnabled(true);
+            mBtnSummarize.setText("Summarize Notifications");
+            Log.i(SMART_TAG, "--- Prompt Dispatch Complete ---");
+        }, 1000);
     }
 }
